# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon or Supabase in production).
# Leave empty in local dev to use embedded PGlite instead.
DATABASE_URL=

# Where PGlite keeps its data when DATABASE_URL is empty.
PGLITE_DATA_DIR=.data/pglite

# Shared secret for the machine routes (/api/sync, /api/collect,
# /api/push/test). At least 32 characters. If unset, those routes reject
# every request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# 511 Alberta developer key: provincial highway cameras (Calgary area, Bow
# Valley, QEII, Edmonton) and all Trip Check data (road conditions, events,
# weather stations). Free: create an account at https://511.alberta.ca, then
# request a key on https://511.alberta.ca/developers/doc.
# If unset, the 511 cameras are skipped and Trip Check has no road data.
ALBERTA_511_API_KEY=

# Trip Check push alerts ("Notify me if this trip gets worse"). Generate your
# own key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is how push services can reach whoever runs the app: a
# mailto: address or an https: URL. Leave all three empty to turn alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Road condition snapshots (Phase 9). In development they're saved under
# SNAPSHOT_DIR. In production, set all four S3_* values to use an
# S3-compatible bucket (Cloudflare R2): either all four or none.
#   S3_ENDPOINT: https://<account id>.r2.cloudflarestorage.com
#   S3_BUCKET:   the bucket name, e.g. camalberta-snapshots
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: an R2 API token with
#     "Object Read & Write" on that bucket only
SNAPSHOT_DIR=.data/snapshots
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 uses "auto"; other S3 services need their region.
S3_REGION=auto

# Admin pages (/admin/label, the label review). A login of their own, not
# CRON_SECRET. In production /admin is a 404 unless ADMIN_ENABLED=true: turn
# it on while you label, then off again (on Vercel, changing a variable needs
# a redeploy). In development it's on unless ADMIN_ENABLED=false. Without a
# username and password it's always off. Five wrong passwords lock that
# address out for 15 minutes.
#   ADMIN_USERNAME: letters, digits and . _ @ - (no colon)
#   ADMIN_PASSWORD: 16+ characters, not the same as CRON_SECRET. Generate:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_ENABLED=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The public site address, for absolute link-preview URLs (og:image etc.).
# Production: https://camalberta.vercel.app (set in Vercel). Unset:
# Vercel's production domain, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
